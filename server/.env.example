# Example environment variables for MatruCare AI server
# Copy this to .env and fill values for your environment

# Server port (optional)
PORT=5000

# MongoDB connection string (Atlas or local). DO NOT commit real credentials.
MONGO_URI=

# JWT secret used to sign authentication tokens. KEEP THIS SECRET IN PRODUCTION.
JWT_SECRET=

# Gmail SMTP Settings (optional for production email delivery)
# SMTP_USER must be the exact Gmail address that will send emails
SMTP_USER=
EMAIL_PASS=
EMAIL_SENDER_NAME=MatruCare AI

CLIENT_URL=http://localhost:5173
